# ─── Supabase (required) ───────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_your_service_role_key

# ─── Geo IP (recommended) ─────────────────────────────
# ipgeolocation.io API key (primary, most accurate)
# Without this, falls back to ipwhois.app (free, HTTPS) then ip-api.com (free, HTTP only)
GEO_API_KEY=

# ─── Base URL (optional) ──────────────────────────────
# Override auto-detected base URL for short links
# BASE_URL=https://your-domain.com

# ─── SMS Providers (optional) ─────────────────────────
# Provider: signalwire (default), telnyx, vonage, webhook
SMS_PROVIDER=signalwire
SMS_FROM=+15551234567

# SignalWire
SIGNALWIRE_SPACE=your-space
SIGNALWIRE_PROJECT_ID=your-project-id
SIGNALWIRE_API_TOKEN=your-api-token

# Telnyx (alternative)
# TELNYX_API_KEY=

# Vonage (alternative)
# VONAGE_API_KEY=
# VONAGE_API_SECRET=

# Generic webhook (alternative)
# SMS_WEBHOOK_URL=

# ─── Port (optional) ──────────────────────────────────
# Default: 3000 (Railway sets PORT automatically)
# PORT=3000
